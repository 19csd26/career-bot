[Unit]
Description=Career Bot - Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=REPO_DIR
ExecStart=REPO_DIR/.venv/bin/python REPO_DIR/telegram_bot.py
Restart=always
RestartSec=5
StandardOutput=append:HOME_DIR/.career-bot/telegram_bot.log
StandardError=append:HOME_DIR/.career-bot/telegram_bot_error.log

[Install]
WantedBy=default.target
