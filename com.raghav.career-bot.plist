<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.raghav.career-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/raghav/career-bot/.venv/bin/python</string>
        <string>/Users/raghav/career-bot/telegram_bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/raghav/career-bot</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/raghav/.career-bot/telegram_bot.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/raghav/.career-bot/telegram_bot_error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
