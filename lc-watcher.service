[Unit]
Description=LeetCode Auto-Committer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=REPO_DIR
ExecStart=REPO_DIR/.venv/bin/python REPO_DIR/lc_watcher.py
Restart=always
RestartSec=5
StandardOutput=append:HOME_DIR/.career-bot/lc_watcher.log
StandardError=append:HOME_DIR/.career-bot/lc_watcher_error.log

[Install]
WantedBy=default.target
